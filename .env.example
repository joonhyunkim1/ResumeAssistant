# ===== OpenAI =====
# 웹 화면의 "초기 설정" 메뉴에서 입력하면 이 파일(.env)에 자동 저장됩니다.
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=

# (선택) 공식 청구 금액 조회용 Admin API Key
# https://platform.openai.com/settings/organization/admin-keys 에서 발급 (조직 Owner 권한 필요)
OPENAI_ADMIN_KEY=

# ===== 모델 =====
# 자소서 작성(기본값, 화면에서 문항별 변경 가능)
WRITER_MODEL=gpt-5.6-terra
# 기업 분석 · 맞춤 프롬프트 생성
ANALYZER_MODEL=gpt-5.6-terra
# 검색어 생성 등 보조 작업 (저렴한 모델)
UTILITY_MODEL=gpt-5.6-luna
EMBEDDING_MODEL=text-embedding-3-small
# 작성 화면에서 고를 수 있는 모델 목록 (단가는 app/pricing.json)
AVAILABLE_MODELS=gpt-5.6-terra,gpt-5.6-sol,gpt-5.6-luna,gpt-6-astra
# 추론 강도: low | medium | high
REASONING_EFFORT=medium

# ===== RAG =====
RAG_TOP_K=8
# 문항·기업 정보로 검색어를 여러 개 만들어 검색 (정확도↑, 비용 극소)
RAG_QUERY_EXPANSION=true
CHUNK_SIZE=700
CHUNK_OVERLAP=120
# 대화 맥락으로 함께 보낼 최근 턴 수
HISTORY_TURNS=10

# ===== 개인정보 =====
# 주민번호·전화번호·이메일·상세주소를 OpenAI 전송 전에 마스킹
PII_MASKING=true
# 추가로 가릴 단어(쉼표 구분) → [지원자]로 치환. 예) 본인 이름
PII_CUSTOM_TERMS=

# ===== 비용 표시 =====
USD_KRW=1400
# 월 예산(USD). 0이면 표시 안 함. 초과 시 사이드바 금액이 빨갛게 표시
MONTHLY_BUDGET_USD=10

# ===== 서버 =====
HOST=127.0.0.1
PORT=8000
